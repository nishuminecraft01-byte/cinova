# ==============================================================================
# CINOVA Environment Variables Template
# Copy to .env.local (never commit real secrets to version control)
# ==============================================================================

# PostgreSQL connection string (Prisma primary database)
# Example: postgresql://USER:PASSWORD@HOST:5432/cinova?schema=public
DATABASE_URL=""

# Optional direct (non-pooled) PostgreSQL URL for Prisma migrations (Supabase/Neon)
DIRECT_URL=""

# Official TMDB v3 Credentials (server-side only — never prefix with NEXT_PUBLIC_)
TMDB_API_READ_ACCESS_TOKEN=""
TMDB_API_KEY=""

# Cron & privileged admin endpoint authorization secrets (server-side only)
CRON_SECRET=""
ADMIN_API_KEY=""

# Local development fallback ISO 3166-1 alpha-2 country code (e.g. US, IN, JP)
DEFAULT_COUNTRY_CODE="US"

# Supabase Auth & Database (required for server-verified user & admin authentication)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-side only — NEVER prefix with NEXT_PUBLIC_ or expose to the browser
SUPABASE_SERVICE_ROLE_KEY=""
