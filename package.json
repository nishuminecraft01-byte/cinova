{
  "name": "cinova",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:local": "next dev",
    "build-css": "tailwindcss -i ./src/app/globals.css -o ./public/styles/globals.css --minify",
    "build": "npm run build-css && next build",
    "build:worker": "npm run build-css && opennextjs-cloudflare build",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "node scripts/build-pages.mjs && wrangler pages deploy pages-dist --project-name cinova --branch main",
    "preview": "npm run build:worker && wrangler dev",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.453.0",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@opennextjs/cloudflare": "^1.20.18",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "postcss": "^8.5.3"
  }
}
